  <ItemGroup>
    <Compile Update="Models\Hotspot.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Compile>
  </ItemGroup>

  <!-- MainWindow is split into several files (MainWindow.Fights.cs etc.);
       show them under MainWindow.xaml in Solution Explorer. -->
  <ItemGroup>
    <Compile Update="MainWindow.*.cs">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Sounds are copied next to the game (WPF's MediaPlayer can't play
       sounds packed inside the program). See Assets/Sounds/README.md. -->
  <ItemGroup>
    <None Remove="Assets\Sounds\**" />
    <Content Include="Assets\Sounds\**\*.wav;Assets\Sounds\**\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

