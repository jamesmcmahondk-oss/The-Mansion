        <!-- ========================================= -->

        <!--
            An open book (Assets/UI/journal_book.png, 1536x1024, shown at
            1440x960). Left page: the entry titles, newest first - click one.
            Right page: the chosen entry. Positions are in the 1440x960 book.
        -->
        <Grid x:Name="JournalScreen"
              Visibility="Collapsed"
              Background="#D8000000"
              MouseLeftButtonDown="JournalScreen_MouseLeftButtonDown"
              Panel.ZIndex="3650">

            <Canvas x:Name="JournalBook"
                    Width="1440"
                    Height="960"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent">

                <Image Source="/Assets/UI/journal_book.png"
                       Width="1440"
                       Height="960"
                       Stretch="Fill">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="Black"/>
                    </Image.Effect>
                </Image>

                <!-- LEFT PAGE: the contents -->
                <TextBlock Canvas.Left="195" Canvas.Top="105"
                           Text="Journal"
                           Foreground="#3A2412"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontWeight="Bold"
                           FontSize="44"/>

                <TextBlock x:Name="JournalSubtitleText"
                           Canvas.Left="198" Canvas.Top="165"
                           Width="470"
                           TextWrapping="Wrap"
                           Foreground="#6B4E31"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="17"/>

                <!-- Tabs: People / Puzzles / Mementos, built by ShowJournal(). -->
                <StackPanel x:Name="JournalTabs"
                            Canvas.Left="198" Canvas.Top="203"
                            Orientation="Horizontal"/>

                <Rectangle Canvas.Left="198" Canvas.Top="245"
                           Width="470" Height="1.5"
                           Fill="#7A5A38" Opacity="0.6"/>

                <!-- Entry titles, built by ShowJournal(); the wheel scrolls. -->
                <ScrollViewer x:Name="JournalScroll"
                              Canvas.Left="190" Canvas.Top="258"
                              Width="490" Height="537"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="JournalEntriesPanel"/>
                </ScrollViewer>

                <!-- RIGHT PAGE: the chosen entry (a portrait or memento picture on top) -->
                <Image x:Name="JournalEntryPicture"
                       Canvas.Left="785" Canvas.Top="100"
                       Width="510" Height="280"
                       Stretch="Uniform"
                       Visibility="Collapsed"/>

                <TextBlock x:Name="JournalEntryTitle"
                           Canvas.Left="785" Canvas.Top="110"
                           Width="500"
                           TextWrapping="Wrap"
                           Foreground="#3A2412"
                           FontFamily="Georgia"
                           FontWeight="Bold"
                           FontSize="30"/>

                <ScrollViewer x:Name="JournalEntryScroll"
                              Canvas.Left="785" Canvas.Top="200"
                              Width="510" Height="590"
                              VerticalScrollBarVisibility="Hidden">
                    <TextBlock x:Name="JournalEntryText"
                               Width="495"
                               TextWrapping="Wrap"
                               Foreground="#3A2412"
                               FontFamily="Georgia"
                               FontSize="22"
                               LineHeight="34"/>
                </ScrollViewer>

                <!-- Close, bottom corner of the right page -->
                <TextBlock x:Name="JournalCloseText"
                           Canvas.Left="1150" Canvas.Top="790"
                           Text="Close  ✕"
                           Foreground="#6B4E31"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="20"
                           Cursor="Hand"
                           MouseEnter="JournalClose_MouseEnter"
                           MouseLeave="JournalClose_MouseLeave"
                           MouseLeftButtonDown="JournalClose_MouseLeftButtonDown"/>
            </Canvas>
        </Grid>

        <!-- ========================================= -->
        <!-- SAVE / LOAD SLOTS                         -->
        <!-- ========================================= -->

        <Grid x:Name="SaveLoadScreen"
              Visibility="Collapsed"
              Background="#C8000000"
              Panel.ZIndex="3700">

            <Border Width="780"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40,30"
                    Background="#F0100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="SaveLoadTitleText"
                               Text="SAVE GAME"
                               HorizontalAlignment="Center"
                               Foreground="#D5B77A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="34"/>

                    <TextBlock x:Name="SaveLoadSubtitleText"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,24"
                               Foreground="#A89A84"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="18"/>

                    <!-- One button per slot, built by ShowSaveLoad() -->
                    <StackPanel x:Name="SaveSlotsPanel"/>

                    <Button Content="BACK"
                            Width="200"
                            Height="50"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource GothicButton}"
                            Click="SaveLoadBack_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- SETTINGS                                  -->
        <!-- ========================================= -->

        <Grid x:Name="SettingsScreen"
              Visibility="Collapsed"
              Background="#C8000000"
              Panel.ZIndex="3750">

            <Border Width="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40,30"
                    Background="#F0100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="SETTINGS"
                               HorizontalAlignment="Center"
                               Foreground="#D5B77A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="34"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="SCREEN"
                               Foreground="#B9A98D"
                               FontFamily="Georgia"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <Button x:Name="FullscreenButton"
                            Content="FULLSCREEN: OFF"
                            Height="50"
                            Margin="0,0,0,18"
                            Style="{StaticResource GothicButton}"
                            Click="FullscreenButton_Click"/>

                    <TextBlock Text="WINDOW SIZE"
                               Foreground="#B9A98D"
                               FontFamily="Georgia"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <!-- One button per resolution, built by ShowSettings() -->
                    <StackPanel x:Name="ResolutionList"/>

                    <TextBlock x:Name="SettingsNoteText"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Foreground="#887966"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="15"/>

                    <TextBlock Text="DICE"
                               Foreground="#B9A98D"
                               FontFamily="Georgia"
                               FontSize="18"
                               Margin="0,20,0,10"/>

                    <!-- One button per dice set, built by BuildDiceSetList() -->
                    <StackPanel x:Name="DiceSetList" Orientation="Horizontal" HorizontalAlignment="Center"/>

                    <TextBlock Text="SOUND"
                               Foreground="#B9A98D"
                               FontFamily="Georgia"
                               FontSize="18"
                               Margin="0,20,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Effects" Foreground="#DDD4C3" FontFamily="Georgia" FontSize="18" VerticalAlignment="Center"/>
                        <Slider x:Name="EffectsVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="EffectsVolumeText" Grid.Column="2" Foreground="#B9A98D" FontFamily="Georgia"
                                   FontSize="16" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Background" Foreground="#DDD4C3" FontFamily="Georgia" FontSize="18" VerticalAlignment="Center"/>
                        <Slider x:Name="MusicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                SmallChange="5" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="5"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="MusicVolumeText" Grid.Column="2" Foreground="#B9A98D" FontFamily="Georgia"
                                   FontSize="16" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="BACK"
                            Width="200"
                            Height="50"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource GothicButton}"
                            Click="SettingsBack_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- DEBUG MENU (F1, Debug builds only)        -->
        <!-- ========================================= -->

        <Border x:Name="DebugMenu"
                Visibility="Collapsed"
                Width="560"
                MaxHeight="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                Background="#F0100C0C"
                BorderBrush="Lime"
                BorderThickness="2"
                Panel.ZIndex="5000">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="DEBUG MENU"
                           Foreground="Lime"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="26"/>

                <TextBlock DockPanel.Dock="Top"
                           Text="F1 or Esc to close"
                           Foreground="#888"
                           FontFamily="Consolas"
                           FontSize="14"
                           Margin="0,2,0,18"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <CheckBox x:Name="DebugHotspotsCheckBox"
                              Content="Show hotspot outlines / hotspot editor"
                              Foreground="White"
                              FontFamily="Consolas"
                              FontSize="16"
                              Click="DebugHotspotsCheckBox_Click"/>

                    <!-- Story flags: set/clear one to test what it changes -->
                    <TextBlock Text="STORY FLAGS"
                               Foreground="Cyan"
                               FontFamily="Consolas"
                               FontSize="16"
                               Margin="0,16,0,6"/>

                    <TextBlock x:Name="DebugFlagsText"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DebugFlagTextBox"
                                 Width="250"
                                 Height="30"
                                 FontFamily="Consolas"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Set"
                                Width="70"
                                Height="30"
                                Margin="8,0,0,0"
                                Click="DebugSetFlag_Click"/>
                        <Button Content="Clear"
                                Width="70"
                                Height="30"
                                Margin="8,0,0,0"
                                Click="DebugClearFlag_Click"/>
                    </StackPanel>

                    <Button Content="Give me every item"
                            Height="36"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="12,0"
                            Click="DebugGiveAllItems_Click"/>

                    <Button Content="Close"
                            Width="140"
                            Height="36"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Click="DebugMenuClose_Click"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="JUMP TO SCENE"
                           Foreground="Cyan"
                           FontFamily="Consolas"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <!-- Filled from Scenes.All / Enemies.All by BuildDebugSceneList() -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="DebugSceneList"/>

                        <TextBlock Text="START A FIGHT (in the current scene)"
                                   Foreground="Cyan"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Margin="0,12,0,8"/>
                        <StackPanel x:Name="DebugFightList"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</Window>