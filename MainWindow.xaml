<Window x:Class="The_Mansion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="The Mansion"
    SizeToContent="WidthAndHeight"
    ResizeMode="CanMinimize"
    WindowStartupLocation="Manual"
    PreviewKeyDown="Window_PreviewKeyDown"
    Background="Black">

    <Window.Resources>
        <!-- Dark red/gold button used by the menus, save slots, trunk and game over. -->
        <Style x:Key="GothicButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D5B77A"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A1612"/>
            <Setter Property="BorderBrush" Value="#806B4A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#4A2418"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFD98A"/>
                                <Setter Property="Foreground" Value="#FFE7B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Fixed-size window with a normal title bar (minimize + close, no
        resize/maximize). The game area inside it is hardcoded to
        1920x1080; SizeToContent wraps the window around it. All screens,
        canvases and hotspot coordinates are laid out in this 1920x1080 space.
    -->
    <!--
        RootGrid is the game's fixed 1920x1080 canvas. ApplyDisplaySettings()
        scales it to the chosen resolution (Settings), so all coordinates stay
        1920x1080. Centred so fullscreen gets black bars if needed.
    -->
    <Grid x:Name="RootGrid"
          Width="1920"
          Height="1080"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderOptions.BitmapScalingMode="HighQuality"
          ClipToBounds="True">
        <!-- ========================================= -->
        <!-- TITLE SCREEN                              -->
        <!-- ========================================= -->

        <Grid x:Name="TitleScreen" Visibility="Visible" >

            <Image Source="Assets/UI/title_screen.png"
               Stretch="Fill"/>
            <Canvas>
                <Rectangle x:Name="NewGameBtn"
             Canvas.Left="239"
             Canvas.Top="435"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <!-- The other buttons painted on title_screen.png (same column). -->
                <Rectangle x:Name="LoadGameBtn"
             Canvas.Left="239"
             Canvas.Top="546"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown"/>

                <Rectangle x:Name="SettingsBtn"
             Canvas.Left="239"
             Canvas.Top="656"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown"/>

                <Rectangle x:Name="QuitBtn"
             Canvas.Left="239"
             Canvas.Top="877"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown"/>


            </Canvas>

        </Grid>
        <!-- ======================================== -->
        <!-- BACKSTORY SCREEN                         -->
        <!-- ======================================== -->

        <Grid x:Name="BackstoryScreen"
          Visibility="Collapsed"
          Background="Black">

            <!-- Dark mansion image -->

            <Image Source="/Assets/UI/title_background.png"
               Stretch="Fill"
               Opacity="0.55"/>

            <!-- Dark overlay makes text easy to read -->

            <Rectangle Fill="#99000000"/>


            <!-- Story -->

            <Grid Width="950"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="THE MANSION"
                           HorizontalAlignment="Center"
                           Foreground="#C8A96A"
                           FontFamily="Georgia"
                           FontSize="46"
                           FontWeight="Bold"
                           Margin="0,0,0,45"/>


                    <TextBlock x:Name="BackstoryText"
                           Foreground="#DDD4C3"
                           FontFamily="Georgia"
                           FontSize="24"
                           LineHeight="38"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>


                    <TextBlock Text="Click to continue..."
                           HorizontalAlignment="Center"
                           Foreground="#887966"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="18"
                           Margin="0,55,0,0"/>

                </StackPanel>

            </Grid>


            <!-- Click anywhere -->

            <Rectangle Fill="Transparent"
                   Cursor="Hand"
                   MouseLeftButtonDown="Backstory_MouseLeftButtonDown"/>

        </Grid>
        <Grid x:Name="PlayerRollScreen"
      Visibility="Collapsed"
      Background="#FF070707">

            <!-- Background -->

            <Image Source="Assets/UI/title_background.png"
           Stretch="UniformToFill"
           Opacity="0.25"
           IsHitTestVisible="False"/>

            <Rectangle Fill="#99000000"
               IsHitTestVisible="False"/>


            <!-- Character generation panel -->

            <Border Width="700"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#E6100C0C"
            BorderBrush="#806B4A"
            BorderThickness="2">

                <StackPanel>
                    <TextBlock Text="YOUR UNFORTUNATE HERO"
   HorizontalAlignment="Center"
   Foreground="#D5B77A"
   FontFamily="Georgia"
   FontWeight="Bold"
   FontSize="35"
   Margin="0,0,0,35"/>

                    <TextBlock Text="NAME"
           Foreground="#B9A98D"
           FontFamily="Georgia"
           FontSize="22"
           HorizontalAlignment="Center"/>

                    <TextBox x:Name="PlayerNameTextBox"
         Width="300"
         Height="40"
         Margin="0,8,0,30"
         FontSize="30"
         MaxLength="20"
         TextAlignment="Center"
         HorizontalAlignment="Center"
         Background="Black"
        Foreground="#D5B77A"/>
                    <TextBlock x:Name="RollCommentText1"
   Text=""
   MinHeight="75"
   Margin="0,35,0,25"
   TextWrapping="Wrap"
   TextAlignment="Center"
   Foreground="#A89A84"
   FontFamily="Georgia"
   FontStyle="Italic"
   FontSize="19"/>


                    <!-- HEALTH -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="HEALTH"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollHealthText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#D95C52"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- STRENGTH -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="STRENGTH"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollStrengthText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- LUCK -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="LUCK"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollLuckText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- WITS -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="WITS"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollWitsText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- COMMENT -->

                    <TextBlock x:Name="RollCommentText"
                       Text=""
                       MinHeight="75"
                       Margin="0,35,0,25"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#A89A84"
                       FontFamily="Georgia"
                       FontStyle="Italic"
                       FontSize="19"/>


                    <!-- REROLLS -->

                    <TextBlock x:Name="RerollsText"
                       Text="Rerolls remaining: 3"
                       HorizontalAlignment="Center"
                       Foreground="#756A59"
                       FontFamily="Georgia"
                       FontSize="16"
                       Margin="0,0,0,20"/>


                    <!-- BUTTONS -->

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Button x:Name="RerollButton"
                        Content="REROLL"
                        Width="180"
                        Height="50"
                        Margin="10"
                        Click="RerollButton_Click"/>

                        <Button Content="ACCEPT"
                        Width="180"
                        Height="50"
                        Margin="10"
                        Click="AcceptRollButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>
        <!-- ========================================= -->
        <!-- CAR TRUNK SCREEN (pick one starting item) -->
        <!-- ========================================= -->

        <Grid x:Name="TrunkScreen"
              Visibility="Collapsed"
              Background="Black">

            <!--
                trunk.png (1536x1024) scaled x1.25 to 1920x1280 and shifted up
                100px so the middle shows. Item positions in Data/Trunk.cs are
                trunk.png pixels; TrunkToScreen() converts them.
            -->
            <Canvas ClipToBounds="True">
                <Image Source="Assets/UI/trunk.png"
                       Width="1920"
                       Height="1280"
                       Canvas.Left="0"
                       Canvas.Top="-100"
                       Stretch="Fill"/>
            </Canvas>

            <!-- Clickable item outlines, added by ShowTrunkScreen() -->
            <Canvas x:Name="TrunkCanvas"/>

            <!-- Title -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,36,0,0"
                    Padding="40,16"
                    Background="#D0100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Text="THE TRUNK OF YOUR CAR"
                               HorizontalAlignment="Center"
                               Foreground="#D5B77A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="34"/>
                    <TextBlock x:Name="TrunkSubtitleText"
                               Text="You may take ONE item into the Mansion. Choose wisely."
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="#A89A84"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="20"/>
                </StackPanel>
            </Border>

            <!-- Item info + take button -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Width="1150"
                    Height="170"
                    Margin="0,0,0,28"
                    Padding="30,18"
                    Background="#E6100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock x:Name="TrunkItemNameText"
                                   Text="Hover over an item"
                                   Foreground="#D5B77A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="28"/>
                        <TextBlock x:Name="TrunkItemDescriptionText"
                                   Text="Click one to choose it."
                                   Margin="0,8,0,0"
                                   Foreground="#DDD4C3"
                                   FontFamily="Georgia"
                                   FontSize="20"
                                   LineHeight="28"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="TrunkTakeButton"
                            Grid.Column="1"
                            Content="CHOOSE AN ITEM"
                            IsEnabled="False"
                            Width="300"
                            Height="64"
                            VerticalAlignment="Center"
                            Style="{StaticResource GothicButton}"
                            Click="TrunkTakeButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- GAME SCREEN                               -->
        <!-- ========================================= -->

        <Grid x:Name="GameScreen"
          Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <!-- Scene spans both rows so the 800px-tall background and its hotspots
                 extend underneath the (partly transparent) HUD frame without being clipped. -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1">
                <!-- GAME SCENE -->
                <Image x:Name="Return" Height="110" VerticalAlignment="Top" Source="/Assets/UI/return_arrow.png" Canvas.Left="10" Canvas.Top="10" Margin="10,0,0,0" Stretch="Fill" Panel.ZIndex="1" Width="220" HorizontalAlignment="Left" />

                <!--
                    Scene backgrounds (1536x1024) are scaled x1.25 to 1920x1280 and
                    cropped to the 1920x800 area above the HUD, centred vertically
                    (Canvas.Top = -240). Hotspots in Data/Scenes.cs are in source-image
                    pixels and are converted with the same numbers - see
                    SceneImageScale / SceneImageCropTop in MainWindow.xaml.cs.
                -->
                <Canvas Height="800" VerticalAlignment="Top" ClipToBounds="True">
                    <Image x:Name="RoomBackground"
                          Source="Assets/Backgrounds/Mansion/frontgate.png"
                          Width="1920"
                          Height="1280"
                          Canvas.Left="0"
                          Canvas.Top="-240"
                          Stretch="Fill" />
                </Canvas>

                <Canvas x:Name="SceneCanvas"
            Background="Transparent"
            MouseMove="SceneCanvas_MouseMove"
            MouseLeftButtonDown="SceneCanvas_MouseLeftButtonDown"
            MouseLeftButtonUp="SceneCanvas_MouseLeftButtonUp"
            Height="800"
            Panel.ZIndex="10" VerticalAlignment="Top"/>

                <!--
                    TALK DIALOG (scene part): dims the scene and blocks hotspot
                    clicks while talking, and shows the character's portrait on
                    the right. Portraits are 1024x1536; at 700px tall the feet
                    tuck behind the HUD frame's top bar (y 790-810).
                -->
                <Rectangle x:Name="DialogueDim"
                           Fill="#8C000000"
                           Height="800"
                           VerticalAlignment="Top"
                           Visibility="Collapsed"
                           Panel.ZIndex="20"/>

                <Image x:Name="DialoguePortrait"
                       Height="700"
                       Margin="0,100,140,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       Panel.ZIndex="21"/>

            </Grid>




            <Border x:Name="DebugPanel"
        Grid.Row="0"
        HorizontalAlignment="Left"
        Margin="1393,10,0,0"
        Padding="10"
        Background="#DD000000"
        BorderBrush="Lime"
        BorderThickness="1"
        Panel.ZIndex="1000"
        IsHitTestVisible="False" Height="136" VerticalAlignment="Top" Width="378">

                <StackPanel>

                    <TextBlock Text="HOTSPOT DEBUG MODE"
                   Foreground="Lime"
                   FontFamily="Consolas"
                   FontSize="16"
                   FontWeight="Bold"/>

                    <TextBlock x:Name="DebugCoordinates"
                   Text="Mouse: X=0 Y=0"
                   Foreground="White"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                    <TextBlock x:Name="DebugSelection"
                   Text="Drag to create a hotspot"
                   Foreground="Cyan"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                </StackPanel>

            </Border>
            <Grid Grid.Row="1"
              x:Name="HUDGrid" Panel.ZIndex="1">
                <Grid.Resources>
                    <!-- Menu buttons fill the pocket's width at their natural 182x62 shape. -->
                    <Style TargetType="Image" x:Key="MenuButtonStyle">
                        <Setter Property="Stretch" Value="Uniform"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>


                <!--
                    HUD layout (this row is 1920x400; numbers are pixels in it).
                    hud_frame.png is built at exactly 1920x400 by
                    Tools/build_hud_frame.py, so nothing is stretched:
                      left button pocket   x 59-236,    y 130-374
                      middle text panel    x 272-1647,  y 138-366
                      right pocket (free)  x 1683-1862, y 130-374
                -->

                <!-- Description text, inside the middle panel with padding. -->
                <TextBlock x:Name="DescriptionText"
           Margin="300,158,300,0"
           Height="190"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Top"
           Text=""
           Foreground="#DDD4C3"
           FontFamily="Georgia"
           FontSize="24"
           LineHeight="34"
           TextWrapping="Wrap"
           TextTrimming="CharacterEllipsis"
           Panel.ZIndex="110" />

                <!--
                    TALK DIALOG (text part): replaces the description text in
                    the middle panel. Speaker name, their line, then up to 4
                    numbered choices (click, or press 1-4).
                -->
                <StackPanel x:Name="DialoguePanel"
                            Margin="300,150,300,0"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Panel.ZIndex="110">

                    <Grid>
                        <TextBlock x:Name="DialogueSpeakerText"
                                   Foreground="#C8A96A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="20"/>

                        <!-- Shown when the player has items to offer -->
                        <TextBlock x:Name="DialogueItemHint"
                                   Text="ITEM: offer something"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#756A59"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="15"/>
                    </Grid>

                    <TextBlock x:Name="DialogueLineText"
                               Foreground="#DDD4C3"
                               FontFamily="Georgia"
                               FontSize="22"
                               LineHeight="30"
                               TextWrapping="Wrap"
                               Margin="0,2,0,10"/>

                    <StackPanel x:Name="DialogueChoicesPanel"/>
                </StackPanel>

                <!--
                    FIGHT PANEL: replaces the description text during a fight.
                    Your two bone dice and total on the left, the enemy's on
                    the right, the result underneath. Click it when the fight
                    is over to continue.
                -->
                <Grid x:Name="FightPanel"
                      Margin="300,146,300,0"
                      Height="214"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      Visibility="Collapsed"
                      MouseLeftButtonDown="FightPanel_MouseLeftButtonDown"
                      Panel.ZIndex="110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header: enemy name + health bar -->
                    <Grid>
                        <TextBlock x:Name="FightTitleText"
                                   Text="FIGHT!"
                                   Foreground="#C8A96A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="EnemyHealthText"
                                       Text="30/30"
                                       Foreground="#D95C52"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Border Width="260" Height="10" VerticalAlignment="Center"
                                    Background="#401010" BorderBrush="#806B4A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="EnemyHealthFill" Width="1*"/>
                                        <ColumnDefinition x:Name="EnemyHealthEmpty" Width="0*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="#C0392B"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Dice -->
                    <Grid Grid.Row="1" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="PlayerDie1" Width="72" Height="72" Source="/Assets/UI/Dice/die_6.png" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                </Image>
                            <Image x:Name="PlayerDie2" Width="72" Height="72" Source="/Assets/UI/Dice/die_6.png" RenderTransformOrigin="0.5,0.5" Margin="6,0,0,0">
                                    <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                </Image>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="YOU" Foreground="#B9A98D" FontFamily="Georgia" FontSize="15"/>
                                <TextBlock x:Name="PlayerAttackText" Text="-" Foreground="#DDD4C3" FontFamily="Consolas" FontSize="30"/>
                                <TextBlock x:Name="PlayerAttackDetail" Text="" Foreground="#887966" FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="VS"
                                   Foreground="#806B4A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="26"
                                   VerticalAlignment="Center"
                                   Margin="20,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="EnemyLabelText" Text="ENEMY" HorizontalAlignment="Right" Foreground="#B9A98D" FontFamily="Georgia" FontSize="15"/>
                                <TextBlock x:Name="EnemyAttackText" Text="-" HorizontalAlignment="Right" Foreground="#DDD4C3" FontFamily="Consolas" FontSize="30"/>
                                <TextBlock x:Name="EnemyAttackDetail" Text="" HorizontalAlignment="Right" Foreground="#887966" FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>
                            <Image x:Name="EnemyDie1" Width="72" Height="72" Source="/Assets/UI/Dice/die_6.png" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                </Image>
                            <Image x:Name="EnemyDie2" Width="72" Height="72" Source="/Assets/UI/Dice/die_6.png" RenderTransformOrigin="0.5,0.5" Margin="6,0,0,0">
                                    <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                </Image>
                        </StackPanel>
                    </Grid>

                    <!-- What happened -->
                    <TextBlock x:Name="FightResultText"
                               Grid.Row="2"
                               Foreground="#DDD4C3"
                               FontFamily="Georgia"
                               FontSize="20"
                               LineHeight="27"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!--
                    INVENTORY (opened with the ITEM button): replaces the
                    description text in the middle panel. Up to 10 item slots
                    in a row; hover to examine, click to pick an item, then
                    click something in the scene to use it on. Esc closes.
                -->
                <Grid x:Name="InventoryPanel"
                      Margin="300,148,300,0"
                      VerticalAlignment="Top"
                      Visibility="Collapsed"
                      Panel.ZIndex="110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="INVENTORY"
                               Foreground="#C8A96A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="20"/>

                    <TextBlock x:Name="InventoryHintText"
                               Text="Click an item to use it  ·  Esc to close"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#756A59"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="15"/>

                    <!-- Filled by OpenInventory() -->
                    <StackPanel x:Name="InventorySlots"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Height="120"
                                Margin="0,8,0,8"/>

                    <TextBlock x:Name="InventoryDescriptionText"
                               Grid.Row="2"
                               Foreground="#DDD4C3"
                               FontFamily="Georgia"
                               FontSize="19"
                               TextWrapping="Wrap"
                               MaxHeight="52"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Image x:Name="HUDDiveders"
  Source="/Assets/UI/hud_frame.png"
  Width="1920"
  Height="400"
  IsHitTestVisible="False" Panel.ZIndex="20" Stretch="Fill"/>

                <!-- Menu buttons, inside the left pocket with 4px padding. -->
                <Grid x:Name="MenuButtons" Margin="63,134,0,0" HorizontalAlignment="Left" Width="169" Height="236" VerticalAlignment="Top" Panel.ZIndex="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <!-- LOOK -->

                    <Image x:Name="LookBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="1"
           Grid.Column="0"
           Source="/Assets/UI/Look.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- ACT -->

                    <Image x:Name="ActBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="0"
           Grid.Column="0"
           Source="/Assets/UI/act.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- TALK -->

                    <Image x:Name="TalkBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="2"
           Grid.Column="0"
           Source="/Assets/UI/talk.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- ITEM -->

                    <Image x:Name="ItemBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="3"
           Grid.Column="0"
           Source="/Assets/UI/item.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>

                </Grid>

                <!--
                    FIGHT BUTTONS: replace the four verbs during a fight
                    (same pocket as MenuButtons). Built by
                    Tools/build_fight_buttons.py.
                -->
                <Grid x:Name="FightButtons" Margin="63,134,0,0" HorizontalAlignment="Left" Width="169" Height="236" VerticalAlignment="Top" Panel.ZIndex="10"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Image x:Name="AttackBtn" Grid.Row="0" Source="/Assets/UI/attack.png"
                           Style="{StaticResource MenuButtonStyle}" Cursor="Hand"
                           MouseEnter="FightButton_MouseEnter" MouseLeave="FightButton_MouseLeave"
                           MouseLeftButtonDown="FightButton_MouseDown"/>

                    <Image x:Name="FightItemBtn" Grid.Row="1" Source="/Assets/UI/item.png"
                           Style="{StaticResource MenuButtonStyle}" Cursor="Hand"
                           MouseEnter="FightButton_MouseEnter" MouseLeave="FightButton_MouseLeave"
                           MouseLeftButtonDown="FightButton_MouseDown"/>

                    <Image x:Name="FleeBtn" Grid.Row="2" Source="/Assets/UI/flee.png"
                           Style="{StaticResource MenuButtonStyle}" Cursor="Hand"
                           MouseEnter="FightButton_MouseEnter" MouseLeave="FightButton_MouseLeave"
                           MouseLeftButtonDown="FightButton_MouseDown"/>
                </Grid>

                <!--
                    Player stats, inside the right pocket (x 1683-1862, y 130-374)
                    with 8px padding. Filled in by UpdatePlayerStats().
                -->
                <StackPanel x:Name="PlayerStatsPanel"
                            Margin="1691,140,0,0"
                            Width="163"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="30"
                            IsHitTestVisible="False">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock" x:Key="StatLabel">
                            <Setter Property="FontFamily" Value="Georgia"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Foreground" Value="#B9A98D"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="StatValue">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="StatText">
                            <Setter Property="FontFamily" Value="Georgia"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Foreground" Value="#DDD4C3"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </StackPanel.Resources>

                    <!-- HEALTH + bar -->
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="HEALTH" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatHealthText" Text="--" Style="{StaticResource StatValue}" Foreground="#D95C52"/>
                    </Grid>
                    <Border Height="7" Margin="0,0,0,8"
                            Background="#401010" BorderBrush="#806B4A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HealthBarFill" Width="1*"/>
                                <ColumnDefinition x:Name="HealthBarEmpty" Width="0*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="#C0392B"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="STRENGTH" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatStrengthText" Text="--" Style="{StaticResource StatValue}" Foreground="#DDD4C3"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="LUCK" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatLuckText" Text="--" Style="{StaticResource StatValue}" Foreground="#DDD4C3"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="WITS" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatWitsText" Text="--" Style="{StaticResource StatValue}" Foreground="#DDD4C3"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#806B4A" Margin="0,4,0,7"/>

                    <TextBlock Text="WEAPON" Style="{StaticResource StatLabel}" FontSize="12"/>
                    <TextBlock x:Name="StatWeaponText" Text="None" Style="{StaticResource StatText}" Margin="0,0,0,6"/>

                    <TextBlock Text="STATUS" Style="{StaticResource StatLabel}" FontSize="12"/>
                    <TextBlock x:Name="StatStatusText" Text="None" Style="{StaticResource StatText}"/>
                </StackPanel>


            </Grid>

        </Grid>

        <!-- ========================================= -->
        <!-- GAME OVER                                 -->
        <!-- ========================================= -->

        <Grid x:Name="GameOverScreen"
              Visibility="Collapsed"
              Background="#E6080404"
              Panel.ZIndex="4000">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="1000">
                <TextBlock Text="YOU HAVE DIED"
                           HorizontalAlignment="Center"
                           Foreground="#B0302A"
                           FontFamily="Georgia"
                           FontWeight="Bold"
                           FontSize="64"/>

                <TextBlock x:Name="GameOverText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,24,0,48"
                           Foreground="#A89A84"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="24"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="GameOverRetryButton"
                            Content="TRY THE FIGHT AGAIN"
                            Width="300"
                            Height="56"
                            Margin="12,0"
                            FontSize="18"
                            Style="{StaticResource GothicButton}"
                            Click="GameOverRetry_Click"/>
                    <Button x:Name="GameOverLoadButton"
                            Content="LOAD A SAVED GAME"
                            Width="300"
                            Height="56"
                            Margin="12,0"
                            FontSize="18"
                            Style="{StaticResource GothicButton}"
                            Click="GameOverLoad_Click"/>
                    <Button Content="START AGAIN"
                            Width="300"
                            Height="56"
                            Margin="12,0"
                            FontSize="18"
                            Style="{StaticResource GothicButton}"
                            Click="GameOverRestart_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ========================================= -->
        <!-- GAME MENU (Esc in game)                   -->
        <!-- ========================================= -->

        <Grid x:Name="GameMenuScreen"
              Visibility="Collapsed"
              Background="#B0000000"
              Panel.ZIndex="3600">

            <Border Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40,30"
                    Background="#F0100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="THE MANSION"
                               HorizontalAlignment="Center"
                               Foreground="#D5B77A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="34"
                               Margin="0,0,0,24"/>

                    <Button Content="RESUME" Height="54" Margin="0,0,0,12"
                            Style="{StaticResource GothicButton}" Click="GameMenuResume_Click"/>
                    <Button x:Name="GameMenuSaveButton" Content="SAVE GAME" Height="54" Margin="0,0,0,12"
                            Style="{StaticResource GothicButton}" Click="GameMenuSave_Click"/>
                    <Button Content="LOAD GAME" Height="54" Margin="0,0,0,12"
                            Style="{StaticResource GothicButton}" Click="GameMenuLoad_Click"/>
                    <Button Content="SETTINGS" Height="54" Margin="0,0,0,12"
                            Style="{StaticResource GothicButton}" Click="GameMenuSettings_Click"/>
                    <Button Content="QUIT TO TITLE" Height="54"
                            Style="{StaticResource GothicButton}" Click="GameMenuQuit_Click"/>

                    <TextBlock x:Name="GameMenuNoteText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"
                               Foreground="#887966"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- SAVE / LOAD SLOTS                         -->
        <!-- ========================================= -->

        <Grid x:Name="SaveLoadScreen"
              Visibility="Collapsed"
              Background="#C8000000"
              Panel.ZIndex="3700">

            <Border Width="780"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40,30"
                    Background="#F0100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="SaveLoadTitleText"
                               Text="SAVE GAME"
                               HorizontalAlignment="Center"
                               Foreground="#D5B77A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="34"/>

                    <TextBlock x:Name="SaveLoadSubtitleText"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,24"
                               Foreground="#A89A84"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="18"/>

                    <!-- One button per slot, built by ShowSaveLoad() -->
                    <StackPanel x:Name="SaveSlotsPanel"/>

                    <Button Content="BACK"
                            Width="200"
                            Height="50"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource GothicButton}"
                            Click="SaveLoadBack_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- SETTINGS                                  -->
        <!-- ========================================= -->

        <Grid x:Name="SettingsScreen"
              Visibility="Collapsed"
              Background="#C8000000"
              Panel.ZIndex="3750">

            <Border Width="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="40,30"
                    Background="#F0100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="SETTINGS"
                               HorizontalAlignment="Center"
                               Foreground="#D5B77A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="34"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="SCREEN"
                               Foreground="#B9A98D"
                               FontFamily="Georgia"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <Button x:Name="FullscreenButton"
                            Content="FULLSCREEN: OFF"
                            Height="50"
                            Margin="0,0,0,18"
                            Style="{StaticResource GothicButton}"
                            Click="FullscreenButton_Click"/>

                    <TextBlock Text="WINDOW SIZE"
                               Foreground="#B9A98D"
                               FontFamily="Georgia"
                               FontSize="18"
                               Margin="0,0,0,10"/>

                    <!-- One button per resolution, built by ShowSettings() -->
                    <StackPanel x:Name="ResolutionList"/>

                    <TextBlock x:Name="SettingsNoteText"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Foreground="#887966"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="15"/>

                    <Button Content="BACK"
                            Width="200"
                            Height="50"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource GothicButton}"
                            Click="SettingsBack_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- DEBUG MENU (F1, Debug builds only)        -->
        <!-- ========================================= -->

        <Border x:Name="DebugMenu"
                Visibility="Collapsed"
                Width="560"
                MaxHeight="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                Background="#F0100C0C"
                BorderBrush="Lime"
                BorderThickness="2"
                Panel.ZIndex="5000">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="DEBUG MENU"
                           Foreground="Lime"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="26"/>

                <TextBlock DockPanel.Dock="Top"
                           Text="F1 or Esc to close"
                           Foreground="#888"
                           FontFamily="Consolas"
                           FontSize="14"
                           Margin="0,2,0,18"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <CheckBox x:Name="DebugHotspotsCheckBox"
                              Content="Show hotspot outlines / hotspot editor"
                              Foreground="White"
                              FontFamily="Consolas"
                              FontSize="16"
                              Click="DebugHotspotsCheckBox_Click"/>

                    <!-- Story flags: set/clear one to test what it changes -->
                    <TextBlock Text="STORY FLAGS"
                               Foreground="Cyan"
                               FontFamily="Consolas"
                               FontSize="16"
                               Margin="0,16,0,6"/>

                    <TextBlock x:Name="DebugFlagsText"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DebugFlagTextBox"
                                 Width="250"
                                 Height="30"
                                 FontFamily="Consolas"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Set"
                                Width="70"
                                Height="30"
                                Margin="8,0,0,0"
                                Click="DebugSetFlag_Click"/>
                        <Button Content="Clear"
                                Width="70"
                                Height="30"
                                Margin="8,0,0,0"
                                Click="DebugClearFlag_Click"/>
                    </StackPanel>

                    <Button Content="Give me every item"
                            Height="36"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="12,0"
                            Click="DebugGiveAllItems_Click"/>

                    <Button Content="Close"
                            Width="140"
                            Height="36"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Click="DebugMenuClose_Click"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="JUMP TO SCENE"
                           Foreground="Cyan"
                           FontFamily="Consolas"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <!-- Filled from Scenes.All / Enemies.All by BuildDebugSceneList() -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="DebugSceneList"/>

                        <TextBlock Text="START A FIGHT (in the current scene)"
                                   Foreground="Cyan"
                                   FontFamily="Consolas"
                                   FontSize="16"
                                   Margin="0,12,0,8"/>
                        <StackPanel x:Name="DebugFightList"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</Window>