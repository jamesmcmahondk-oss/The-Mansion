<Window x:Class="The_Mansion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="The Mansion"
    SizeToContent="WidthAndHeight"
    ResizeMode="CanMinimize"
    WindowStartupLocation="Manual"
    PreviewKeyDown="Window_PreviewKeyDown"
    Background="Black">

    <!--
        Fixed-size window with a normal title bar (minimize + close, no
        resize/maximize). The game area inside it is hardcoded to
        1920x1080; SizeToContent wraps the window around it. All screens,
        canvases and hotspot coordinates are laid out in this 1920x1080 space.
    -->
    <Grid x:Name="RootGrid"
          Width="1920"
          Height="1080"
          ClipToBounds="True">
        <!-- ========================================= -->
        <!-- TITLE SCREEN                              -->
        <!-- ========================================= -->

        <Grid x:Name="TitleScreen" Visibility="Visible" >

            <Image Source="Assets/UI/title_screen.png"
               Stretch="Fill"/>
            <Canvas>
                <Rectangle x:Name="NewGameBtn"
             Canvas.Left="239"
             Canvas.Top="435"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Top"/>


            </Canvas>

        </Grid>
        <!-- ======================================== -->
        <!-- BACKSTORY SCREEN                         -->
        <!-- ======================================== -->

        <Grid x:Name="BackstoryScreen"
          Visibility="Collapsed"
          Background="Black">

            <!-- Dark mansion image -->

            <Image Source="/Assets/UI/title_background.png"
               Stretch="Fill"
               Opacity="0.55"/>

            <!-- Dark overlay makes text easy to read -->

            <Rectangle Fill="#99000000"/>


            <!-- Story -->

            <Grid Width="950"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="THE MANSION"
                           HorizontalAlignment="Center"
                           Foreground="#C8A96A"
                           FontFamily="Georgia"
                           FontSize="46"
                           FontWeight="Bold"
                           Margin="0,0,0,45"/>


                    <TextBlock x:Name="BackstoryText"
                           Foreground="#DDD4C3"
                           FontFamily="Georgia"
                           FontSize="24"
                           LineHeight="38"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>


                    <TextBlock Text="Click to continue..."
                           HorizontalAlignment="Center"
                           Foreground="#887966"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="18"
                           Margin="0,55,0,0"/>

                </StackPanel>

            </Grid>


            <!-- Click anywhere -->

            <Rectangle Fill="Transparent"
                   Cursor="Hand"
                   MouseLeftButtonDown="Backstory_MouseLeftButtonDown"/>

        </Grid>
        <Grid x:Name="PlayerRollScreen"
      Visibility="Collapsed"
      Background="#FF070707">

            <!-- Background -->

            <Image Source="Assets/UI/title_background.png"
           Stretch="UniformToFill"
           Opacity="0.25"
           IsHitTestVisible="False"/>

            <Rectangle Fill="#99000000"
               IsHitTestVisible="False"/>


            <!-- Character generation panel -->

            <Border Width="700"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#E6100C0C"
            BorderBrush="#806B4A"
            BorderThickness="2">

                <StackPanel>
                    <TextBlock Text="YOUR UNFORTUNATE HERO"
   HorizontalAlignment="Center"
   Foreground="#D5B77A"
   FontFamily="Georgia"
   FontWeight="Bold"
   FontSize="35"
   Margin="0,0,0,35"/>

                    <TextBlock Text="NAME"
           Foreground="#B9A98D"
           FontFamily="Georgia"
           FontSize="22"
           HorizontalAlignment="Center"/>

                    <TextBox x:Name="PlayerNameTextBox"
         Width="300"
         Height="40"
         Margin="0,8,0,30"
         FontSize="30"
         MaxLength="20"
         TextAlignment="Center"
         HorizontalAlignment="Center"
         Background="Black"
        Foreground="#D5B77A"/>
                    <TextBlock x:Name="RollCommentText1"
   Text=""
   MinHeight="75"
   Margin="0,35,0,25"
   TextWrapping="Wrap"
   TextAlignment="Center"
   Foreground="#A89A84"
   FontFamily="Georgia"
   FontStyle="Italic"
   FontSize="19"/>


                    <!-- HEALTH -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="HEALTH"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollHealthText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#D95C52"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- STRENGTH -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="STRENGTH"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollStrengthText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- LUCK -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="LUCK"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollLuckText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- WITS -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="WITS"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollWitsText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- COMMENT -->

                    <TextBlock x:Name="RollCommentText"
                       Text=""
                       MinHeight="75"
                       Margin="0,35,0,25"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#A89A84"
                       FontFamily="Georgia"
                       FontStyle="Italic"
                       FontSize="19"/>


                    <!-- REROLLS -->

                    <TextBlock x:Name="RerollsText"
                       Text="Rerolls remaining: 3"
                       HorizontalAlignment="Center"
                       Foreground="#756A59"
                       FontFamily="Georgia"
                       FontSize="16"
                       Margin="0,0,0,20"/>


                    <!-- BUTTONS -->

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Button x:Name="RerollButton"
                        Content="REROLL"
                        Width="180"
                        Height="50"
                        Margin="10"
                        Click="RerollButton_Click"/>

                        <Button Content="ACCEPT"
                        Width="180"
                        Height="50"
                        Margin="10"
                        Click="AcceptRollButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>
        <!-- ========================================= -->
        <!-- GAME SCREEN                               -->
        <!-- ========================================= -->

        <Grid x:Name="GameScreen"
          Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <!-- Scene spans both rows so the 800px-tall background and its hotspots
                 extend underneath the (partly transparent) HUD frame without being clipped. -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1">
                <!-- GAME SCENE -->
                <Image x:Name="Return" Height="110" VerticalAlignment="Top" Source="/Assets/UI/return_arrow.png" Canvas.Left="10" Canvas.Top="10" Margin="10,0,0,0" Stretch="Fill" Panel.ZIndex="1" Width="220" HorizontalAlignment="Left" />

                <!--
                    Scene backgrounds (1536x1024) are scaled x1.25 to 1920x1280 and
                    cropped to the 1920x800 area above the HUD, centred vertically
                    (Canvas.Top = -240). Hotspots in Data/Scenes.cs are in source-image
                    pixels and are converted with the same numbers - see
                    SceneImageScale / SceneImageCropTop in MainWindow.xaml.cs.
                -->
                <Canvas Height="800" VerticalAlignment="Top" ClipToBounds="True">
                    <Image x:Name="RoomBackground"
                          Source="Assets/Backgrounds/Mansion/frontgate.png"
                          Width="1920"
                          Height="1280"
                          Canvas.Left="0"
                          Canvas.Top="-240"
                          Stretch="Fill" />
                </Canvas>

                <Canvas x:Name="SceneCanvas"
            Background="Transparent"
            MouseMove="SceneCanvas_MouseMove"
            MouseLeftButtonDown="SceneCanvas_MouseLeftButtonDown"
            MouseLeftButtonUp="SceneCanvas_MouseLeftButtonUp"
            Height="800"
            Panel.ZIndex="10" VerticalAlignment="Top"/>

                <!--
                    TALK DIALOG (scene part): dims the scene and blocks hotspot
                    clicks while talking, and shows the character's portrait on
                    the right. Portraits are 1024x1536; at 700px tall the feet
                    tuck behind the HUD frame's top bar (y 790-810).
                -->
                <Rectangle x:Name="DialogueDim"
                           Fill="#8C000000"
                           Height="800"
                           VerticalAlignment="Top"
                           Visibility="Collapsed"
                           Panel.ZIndex="20"/>

                <Image x:Name="DialoguePortrait"
                       Height="700"
                       Margin="0,100,140,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       Panel.ZIndex="21"/>

            </Grid>




            <Border x:Name="DebugPanel"
        Grid.Row="0"
        HorizontalAlignment="Left"
        Margin="1393,10,0,0"
        Padding="10"
        Background="#DD000000"
        BorderBrush="Lime"
        BorderThickness="1"
        Panel.ZIndex="1000"
        IsHitTestVisible="False" Height="136" VerticalAlignment="Top" Width="378">

                <StackPanel>

                    <TextBlock Text="HOTSPOT DEBUG MODE"
                   Foreground="Lime"
                   FontFamily="Consolas"
                   FontSize="16"
                   FontWeight="Bold"/>

                    <TextBlock x:Name="DebugCoordinates"
                   Text="Mouse: X=0 Y=0"
                   Foreground="White"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                    <TextBlock x:Name="DebugSelection"
                   Text="Drag to create a hotspot"
                   Foreground="Cyan"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                </StackPanel>

            </Border>
            <Grid Grid.Row="1"
              x:Name="HUDGrid" Panel.ZIndex="1">
                <Grid.Resources>
                    <!-- Menu buttons fill the pocket's width at their natural 182x62 shape. -->
                    <Style TargetType="Image" x:Key="MenuButtonStyle">
                        <Setter Property="Stretch" Value="Uniform"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>


                <!--
                    HUD layout (this row is 1920x400; numbers are pixels in it).
                    hud_frame.png is built at exactly 1920x400 by
                    Tools/build_hud_frame.py, so nothing is stretched:
                      left button pocket   x 59-236,    y 130-374
                      middle text panel    x 272-1647,  y 138-366
                      right pocket (free)  x 1683-1862, y 130-374
                -->

                <!-- Description text, inside the middle panel with padding. -->
                <TextBlock x:Name="DescriptionText"
           Margin="300,158,300,0"
           Height="190"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Top"
           Text=""
           Foreground="#DDD4C3"
           FontFamily="Georgia"
           FontSize="24"
           LineHeight="34"
           TextWrapping="Wrap"
           TextTrimming="CharacterEllipsis"
           Panel.ZIndex="110" />

                <!--
                    TALK DIALOG (text part): replaces the description text in
                    the middle panel. Speaker name, their line, then up to 4
                    numbered choices (click, or press 1-4).
                -->
                <StackPanel x:Name="DialoguePanel"
                            Margin="300,150,300,0"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Panel.ZIndex="110">

                    <TextBlock x:Name="DialogueSpeakerText"
                               Foreground="#C8A96A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="20"/>

                    <TextBlock x:Name="DialogueLineText"
                               Foreground="#DDD4C3"
                               FontFamily="Georgia"
                               FontSize="22"
                               LineHeight="30"
                               TextWrapping="Wrap"
                               Margin="0,2,0,10"/>

                    <StackPanel x:Name="DialogueChoicesPanel"/>
                </StackPanel>

                <!--
                    INVENTORY (opened with the ITEM button): replaces the
                    description text in the middle panel. Up to 10 item slots
                    in a row; hover to examine, click to pick an item, then
                    click something in the scene to use it on. Esc closes.
                -->
                <Grid x:Name="InventoryPanel"
                      Margin="300,148,300,0"
                      VerticalAlignment="Top"
                      Visibility="Collapsed"
                      Panel.ZIndex="110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="INVENTORY"
                               Foreground="#C8A96A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="20"/>

                    <TextBlock Text="Click an item to use it  ·  Esc to close"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#756A59"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="15"/>

                    <!-- Filled by OpenInventory() -->
                    <StackPanel x:Name="InventorySlots"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Height="120"
                                Margin="0,8,0,8"/>

                    <TextBlock x:Name="InventoryDescriptionText"
                               Grid.Row="2"
                               Foreground="#DDD4C3"
                               FontFamily="Georgia"
                               FontSize="19"
                               TextWrapping="Wrap"
                               MaxHeight="52"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Image x:Name="HUDDiveders"
  Source="/Assets/UI/hud_frame.png"
  Width="1920"
  Height="400"
  IsHitTestVisible="False" Panel.ZIndex="20" Stretch="Fill"/>

                <!-- Menu buttons, inside the left pocket with 4px padding. -->
                <Grid x:Name="MenuButtons" Margin="63,134,0,0" HorizontalAlignment="Left" Width="169" Height="236" VerticalAlignment="Top" Panel.ZIndex="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <!-- LOOK -->

                    <Image x:Name="LookBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="1"
           Grid.Column="0"
           Source="/Assets/UI/Look.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- ACT -->

                    <Image x:Name="ActBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="0"
           Grid.Column="0"
           Source="/Assets/UI/act.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- TALK -->

                    <Image x:Name="TalkBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="2"
           Grid.Column="0"
           Source="/Assets/UI/talk.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- ITEM -->

                    <Image x:Name="ItemBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="3"
           Grid.Column="0"
           Source="/Assets/UI/item.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>

                </Grid>

                <!--
                    Player stats, inside the right pocket (x 1683-1862, y 130-374)
                    with 8px padding. Filled in by UpdatePlayerStats().
                -->
                <StackPanel x:Name="PlayerStatsPanel"
                            Margin="1691,140,0,0"
                            Width="163"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="30"
                            IsHitTestVisible="False">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock" x:Key="StatLabel">
                            <Setter Property="FontFamily" Value="Georgia"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Foreground" Value="#B9A98D"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="StatValue">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="StatText">
                            <Setter Property="FontFamily" Value="Georgia"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Foreground" Value="#DDD4C3"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </StackPanel.Resources>

                    <!-- HEALTH + bar -->
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="HEALTH" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatHealthText" Text="--" Style="{StaticResource StatValue}" Foreground="#D95C52"/>
                    </Grid>
                    <Border Height="7" Margin="0,0,0,8"
                            Background="#401010" BorderBrush="#806B4A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HealthBarFill" Width="1*"/>
                                <ColumnDefinition x:Name="HealthBarEmpty" Width="0*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="#C0392B"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="STRENGTH" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatStrengthText" Text="--" Style="{StaticResource StatValue}" Foreground="#DDD4C3"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="LUCK" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatLuckText" Text="--" Style="{StaticResource StatValue}" Foreground="#DDD4C3"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="WITS" Style="{StaticResource StatLabel}"/>
                        <TextBlock x:Name="StatWitsText" Text="--" Style="{StaticResource StatValue}" Foreground="#DDD4C3"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#806B4A" Margin="0,4,0,7"/>

                    <TextBlock Text="WEAPON" Style="{StaticResource StatLabel}" FontSize="12"/>
                    <TextBlock x:Name="StatWeaponText" Text="None" Style="{StaticResource StatText}" Margin="0,0,0,6"/>

                    <TextBlock Text="STATUS" Style="{StaticResource StatLabel}" FontSize="12"/>
                    <TextBlock x:Name="StatStatusText" Text="None" Style="{StaticResource StatText}"/>
                </StackPanel>


            </Grid>

        </Grid>

        <!-- ========================================= -->
        <!-- DEBUG MENU (F1, Debug builds only)        -->
        <!-- ========================================= -->

        <Border x:Name="DebugMenu"
                Visibility="Collapsed"
                Width="560"
                MaxHeight="900"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="24"
                Background="#F0100C0C"
                BorderBrush="Lime"
                BorderThickness="2"
                Panel.ZIndex="5000">

            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="DEBUG MENU"
                           Foreground="Lime"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="26"/>

                <TextBlock DockPanel.Dock="Top"
                           Text="F1 or Esc to close"
                           Foreground="#888"
                           FontFamily="Consolas"
                           FontSize="14"
                           Margin="0,2,0,18"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <CheckBox x:Name="DebugHotspotsCheckBox"
                              Content="Show hotspot outlines / hotspot editor"
                              Foreground="White"
                              FontFamily="Consolas"
                              FontSize="16"
                              Click="DebugHotspotsCheckBox_Click"/>

                    <!-- Story flags: set/clear one to test what it changes -->
                    <TextBlock Text="STORY FLAGS"
                               Foreground="Cyan"
                               FontFamily="Consolas"
                               FontSize="16"
                               Margin="0,16,0,6"/>

                    <TextBlock x:Name="DebugFlagsText"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DebugFlagTextBox"
                                 Width="250"
                                 Height="30"
                                 FontFamily="Consolas"
                                 FontSize="15"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Set"
                                Width="70"
                                Height="30"
                                Margin="8,0,0,0"
                                Click="DebugSetFlag_Click"/>
                        <Button Content="Clear"
                                Width="70"
                                Height="30"
                                Margin="8,0,0,0"
                                Click="DebugClearFlag_Click"/>
                    </StackPanel>

                    <Button Content="Give me every item"
                            Height="36"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="12,0"
                            Click="DebugGiveAllItems_Click"/>

                    <Button Content="Close"
                            Width="140"
                            Height="36"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Right"
                            Click="DebugMenuClose_Click"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="JUMP TO SCENE"
                           Foreground="Cyan"
                           FontFamily="Consolas"
                           FontSize="16"
                           Margin="0,0,0,8"/>

                <!-- Filled from Scenes.All by BuildDebugSceneList() -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DebugSceneList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

    </Grid>
</Window>