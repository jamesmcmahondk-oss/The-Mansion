<Window x:Class="The_Mansion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="The Mansion"
    SizeToContent="WidthAndHeight"
    ResizeMode="CanMinimize"
    WindowStartupLocation="Manual"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewKeyUp="Window_PreviewKeyUp"
    PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
    Background="Black">

    <Window.Resources>
        <!-- Dark red/gold button used by the menus, save slots, trunk and game over. -->
        <Style x:Key="GothicButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D5B77A"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A1612"/>
            <Setter Property="BorderBrush" Value="#806B4A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="#4A2418"/>
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#FFD98A"/>
                                <Setter Property="Foreground" Value="#FFE7B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        Fixed-size window with a normal title bar (minimize + close, no
        resize/maximize). The game area inside it is hardcoded to
        1920x1080; SizeToContent wraps the window around it. All screens,
        canvases and hotspot coordinates are laid out in this 1920x1080 space.
    -->
    <!--
        RootGrid is the game's fixed 1920x1080 canvas. ApplyDisplaySettings()
        scales it to the chosen resolution (Settings), so all coordinates stay
        1920x1080. Centred so fullscreen gets black bars if needed.
    -->
    <Grid x:Name="RootGrid"
          Width="1920"
          Height="1080"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderOptions.BitmapScalingMode="HighQuality"
          ClipToBounds="True">
        <!-- ========================================= -->
        <!-- TITLE SCREEN                              -->
        <!-- ========================================= -->

        <Grid x:Name="TitleScreen" Visibility="Visible" >

            <Image Source="Assets/UI/title_screen.png"
               Stretch="Fill"/>
            <Canvas>
                <Rectangle x:Name="NewGameBtn"
             Canvas.Left="239"
             Canvas.Top="435"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <!-- The other buttons painted on title_screen.png (same column). -->
                <Rectangle x:Name="LoadGameBtn"
             Canvas.Left="239"
             Canvas.Top="546"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown"/>

                <Rectangle x:Name="SettingsBtn"
             Canvas.Left="239"
             Canvas.Top="656"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown"/>

                <Rectangle x:Name="CreditsBtn"
             Canvas.Left="239"
             Canvas.Top="766"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown"/>

                <Rectangle x:Name="QuitBtn"
             Canvas.Left="239"
             Canvas.Top="877"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown"/>


            </Canvas>

        </Grid>
        <!-- ======================================== -->
        <!-- BACKSTORY SCREEN                         -->
        <!-- ======================================== -->

        <Grid x:Name="BackstoryScreen"
          Visibility="Collapsed"
          Background="Black">

            <!-- Dark mansion image -->

            <Image Source="/Assets/UI/title_background.png"
               Stretch="Fill"
               Opacity="0.55"/>

            <!-- Dark overlay makes text easy to read -->

            <Rectangle Fill="#99000000"/>


            <!-- Story -->

            <Grid Width="950"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="THE MANSION"
                           HorizontalAlignment="Center"
                           Foreground="#C8A96A"
                           FontFamily="Georgia"
                           FontSize="46"
                           FontWeight="Bold"
                           Margin="0,0,0,45"/>


                    <TextBlock x:Name="BackstoryText"
                           Foreground="#DDD4C3"
                           FontFamily="Georgia"
                           FontSize="24"
                           LineHeight="38"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>


                    <TextBlock x:Name="BackstoryContinueText"
                           Text="Click to continue..."
                           HorizontalAlignment="Center"
                           Foreground="#887966"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="18"
                           Margin="0,55,0,0"/>

                </StackPanel>

            </Grid>


            <!-- Click anywhere -->

            <Rectangle Fill="Transparent"
                   Cursor="Hand"
                   MouseLeftButtonDown="Backstory_MouseLeftButtonDown"/>

        </Grid>
        <Grid x:Name="PlayerRollScreen"
      Visibility="Collapsed"
      Background="#FF070707">

            <!-- Background -->

            <Image Source="Assets/UI/title_background.png"
           Stretch="UniformToFill"
           Opacity="0.25"
           IsHitTestVisible="False"/>

            <Rectangle Fill="#99000000"
               IsHitTestVisible="False"/>


            <!--
                Character generation panel: the painted frame (Assets/UI/roll_frame.png,
                926x1120, from the mockup) with live text laid on top. Positions are
                frame pixels; the Viewbox scales the whole panel to fit the screen.
            -->
            <Viewbox Height="1040" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="926" Height="1120">
                    <Canvas.Resources>
                        <!-- The REROLL / ACCEPT buttons are painted on the frame:
                             these are invisible click areas that glow on hover. -->
                        <Style x:Key="PaintedButton" TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Glow" Background="Transparent" CornerRadius="22"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Glow" Property="Background" Value="#30FFD98A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Glow" Property="Background" Value="#50FFD98A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Glow" Property="Background" Value="#AA000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Canvas.Resources>

                    <Image Source="/Assets/UI/roll_frame.png" Width="926" Height="1120"/>

                    <!-- NAME (the box is painted; the text box is see-through) -->
                    <TextBox x:Name="PlayerNameTextBox"
                             Canvas.Left="272" Canvas.Top="243" Width="385" Height="46"
                             FontSize="28" FontFamily="Georgia" MaxLength="20"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#D5B77A" CaretBrush="#D5B77A"/>

                    <TextBlock x:Name="RollCommentText1"
                               Canvas.Left="60" Canvas.Top="300" Width="806" TextAlignment="Center"
                               Foreground="#D95C52" FontFamily="Georgia" FontStyle="Italic" FontSize="19"/>

                    <TextBlock Canvas.Left="71" Canvas.Top="512" Text="HEALTH" Foreground="#D9C9A8" FontFamily="Georgia" FontSize="27"/>
                    <TextBlock x:Name="RollHealthText" Canvas.Left="564" Canvas.Top="512" Width="300" TextAlignment="Right" Text="--"
                               Foreground="#D95C52" FontFamily="Consolas" FontSize="28"/>
                    <TextBlock Canvas.Left="71" Canvas.Top="569" Text="STRENGTH" Foreground="#D9C9A8" FontFamily="Georgia" FontSize="27"/>
                    <TextBlock x:Name="RollStrengthText" Canvas.Left="564" Canvas.Top="569" Width="300" TextAlignment="Right" Text="--"
                               Foreground="#EDE4D3" FontFamily="Consolas" FontSize="28"/>
                    <TextBlock Canvas.Left="71" Canvas.Top="627" Text="LUCK" Foreground="#D9C9A8" FontFamily="Georgia" FontSize="27"/>
                    <TextBlock x:Name="RollLuckText" Canvas.Left="564" Canvas.Top="627" Width="300" TextAlignment="Right" Text="--"
                               Foreground="#EDE4D3" FontFamily="Consolas" FontSize="28"/>
                    <TextBlock Canvas.Left="71" Canvas.Top="684" Text="WITS" Foreground="#D9C9A8" FontFamily="Georgia" FontSize="27"/>
                    <TextBlock x:Name="RollWitsText" Canvas.Left="564" Canvas.Top="684" Width="300" TextAlignment="Right" Text="--"
                               Foreground="#EDE4D3" FontFamily="Consolas" FontSize="28"/>

                    <TextBlock x:Name="RollCommentText"
                               Canvas.Left="70" Canvas.Top="762" Width="786" TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#CFC3AE" FontFamily="Georgia" FontStyle="Italic" FontSize="23"/>

                    <TextBlock x:Name="RerollsText"
                               Canvas.Left="60" Canvas.Top="897" Width="806" TextAlignment="Center"
                               Text="Rerolls remaining: 3"
                               Foreground="#B9A98D" FontFamily="Georgia" FontSize="20"/>

                    <Button x:Name="RerollButton" Style="{StaticResource PaintedButton}"
                            Canvas.Left="100" Canvas.Top="955" Width="334" Height="100"
                            Click="RerollButton_Click"/>

                    <Button Style="{StaticResource PaintedButton}"
                            Canvas.Left="480" Canvas.Top="955" Width="344" Height="100"
                            Click="AcceptRollButton_Click"/>
                </Canvas>
            </Viewbox>

        </Grid>
        <!-- ========================================= -->
        <!-- CAR TRUNK SCREEN (pick one starting item) -->
        <!-- ========================================= -->

        <Grid x:Name="TrunkScreen"
              Visibility="Collapsed"
              Background="Black">

            <!--
                trunk.png (1536x1024) scaled x1.25 to 1920x1280 and shifted up
                100px so the middle shows. Item positions in Data/Trunk.cs are
                trunk.png pixels; TrunkToScreen() converts them.
            -->
            <Canvas ClipToBounds="True">
                <Image Source="Assets/UI/trunk.png"
                       Width="1920"
                       Height="1280"
                       Canvas.Left="0"
                       Canvas.Top="-100"
                       Stretch="Fill"/>
            </Canvas>

            <!-- Clickable item outlines, added by ShowTrunkScreen() -->
            <Canvas x:Name="TrunkCanvas"/>

            <!-- Title -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,36,0,0"
                    Padding="40,16"
                    Background="#D0100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Text="THE TRUNK OF YOUR CAR"
                               HorizontalAlignment="Center"
                               Foreground="#D5B77A"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               FontSize="34"/>
                    <TextBlock x:Name="TrunkSubtitleText"
                               Text="You may take ONE item into the Mansion. Choose wisely."
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="#A89A84"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="20"/>
                </StackPanel>
            </Border>

            <!-- Item info + take button -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Width="1150"
                    Height="170"
                    Margin="0,0,0,28"
                    Padding="30,18"
                    Background="#E6100C0C"
                    BorderBrush="#806B4A"
                    BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,30,0">
                        <TextBlock x:Name="TrunkItemNameText"
                                   Text="Hover over an item"
                                   Foreground="#D5B77A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="28"/>
                        <TextBlock x:Name="TrunkItemDescriptionText"
                                   Text="Click one to choose it."
                                   Margin="0,8,0,0"
                                   Foreground="#DDD4C3"
                                   FontFamily="Georgia"
                                   FontSize="20"
                                   LineHeight="28"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="TrunkTakeButton"
                            Grid.Column="1"
                            Content="CHOOSE AN ITEM"
                            IsEnabled="False"
                            Width="300"
                            Height="64"
                            VerticalAlignment="Center"
                            Style="{StaticResource GothicButton}"
                            Click="TrunkTakeButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================= -->
        <!-- GAME SCREEN                               -->
        <!-- ========================================= -->

        <Grid x:Name="GameScreen"
          Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <!-- Scene spans both rows so the 800px-tall background and its hotspots
                 extend underneath the (partly transparent) HUD frame without being clipped. -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1">
                <!-- GAME SCENE -->
                <Image x:Name="Return" Height="110" VerticalAlignment="Top" Source="/Assets/UI/return_arrow.png" Canvas.Left="10" Canvas.Top="10" Margin="10,0,0,0" Stretch="Fill" Panel.ZIndex="1" Width="220" HorizontalAlignment="Left" />

                <!--
                    Scene backgrounds (1536x1024) are scaled x1.25 to 1920x1280 and
                    cropped to the 1920x800 area above the HUD, centred vertically
                    (Canvas.Top = -240). Hotspots in Data/Scenes.cs are in source-image
                    pixels and are converted with the same numbers - see
                    SceneImageScale / SceneImageCropTop in MainWindow.xaml.cs.
                -->
                <Canvas Height="800" VerticalAlignment="Top" ClipToBounds="True">
                    <Image x:Name="RoomBackground"
                          Source="Assets/Backgrounds/Mansion/frontgate.png"
                          Width="1920"
                          Height="1280"
                          Canvas.Left="0"
                          Canvas.Top="-240"
                          Stretch="Fill" />
                </Canvas>

                <Canvas x:Name="SceneCanvas"
            Background="Transparent"
            MouseMove="SceneCanvas_MouseMove"
            MouseLeave="SceneCanvas_MouseLeave"
            MouseLeftButtonDown="SceneCanvas_MouseLeftButtonDown"
            MouseLeftButtonUp="SceneCanvas_MouseLeftButtonUp"
            Height="800"
            Panel.ZIndex="10" VerticalAlignment="Top"/>

                <!--
                    Name of the hotspot under the cursor, following the mouse
                    (placed by UpdateHoverLabel). Never takes clicks.
                -->
                <Canvas Height="800" VerticalAlignment="Top"
                        IsHitTestVisible="False" Panel.ZIndex="15">
                    <Border x:Name="HoverLabel"
                            Visibility="Collapsed"
                            Background="#B0000000"
                            BorderBrush="#806B4A"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,3,10,4">
                        <TextBlock x:Name="HoverLabelText"
                                   Foreground="#C8A96A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="20"/>
                    </Border>
                </Canvas>

                <!--
                    Black curtain over the scene: ShowScene() snaps it to
                    black and fades it away, so scenes don't hard-cut.
                -->
                <Rectangle x:Name="SceneFade"
                           Fill="Black"
                           Height="800"
                           VerticalAlignment="Top"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Panel.ZIndex="30"/>

                <!--
                    "New journal entry" notice: fades in and out top-right
                    (ShowJournalToast). J opens the journal.
                -->
                <Border x:Name="JournalToast"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,40,40,0"
                        Padding="22,12,22,14"
                        Background="#E0100C0C"
                        BorderBrush="#806B4A"
                        BorderThickness="2"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Panel.ZIndex="40">
                    <StackPanel>
                        <TextBlock Text="NEW JOURNAL ENTRY"
                                   Foreground="#887966"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="14"/>
                        <TextBlock x:Name="JournalToastText"
                                   Margin="0,4,0,0"
                                   Foreground="#C8A96A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="22"/>
                        <TextBlock Text="Press J to read your journal"
                                   Margin="0,4,0,0"
                                   Foreground="#756A59"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="14"/>
                    </StackPanel>
                </Border>

                <!--
                    TALK DIALOG (scene part): dims the scene and blocks hotspot
                    clicks while talking, and shows the character's portrait on
                    the right. Portraits are 1024x1536; at 700px tall the feet
                    tuck behind the HUD frame's top bar (y 790-810).
                -->
                <Rectangle x:Name="DialogueDim"
                           Fill="#8C000000"
                           Height="800"
                           VerticalAlignment="Top"
                           Visibility="Collapsed"
                           Panel.ZIndex="20"/>

                <!--
                    Close-up framed portrait (.Portrait in dialogues/enemies).
                    Always in the same spot: background pixels X 60, Y 350,
                    height 400 - placed by PlaceCloseUpPortrait().
                -->
                <Image x:Name="DialoguePortrait"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       Panel.ZIndex="22">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.75" Color="Black"/>
                    </Image.Effect>
                </Image>

                <!-- Full-body character picture (.Character + .StandAt). -->
                <Image x:Name="DialogueCharacter"
                       Height="700"
                       Margin="0,100,140,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"
                       Panel.ZIndex="21"/>

            </Grid>




            <Border x:Name="DebugPanel"
        Grid.Row="0"
        HorizontalAlignment="Left"
        Margin="1393,10,0,0"
        Padding="10"
        Background="#DD000000"
        BorderBrush="Lime"
        BorderThickness="1"
        Panel.ZIndex="1000"
        IsHitTestVisible="False" Height="136" VerticalAlignment="Top" Width="378">

                <StackPanel>

                    <TextBlock Text="HOTSPOT DEBUG MODE"
                   Foreground="Lime"
                   FontFamily="Consolas"
                   FontSize="16"
                   FontWeight="Bold"/>

                    <TextBlock x:Name="DebugCoordinates"
                   Text="Mouse: X=0 Y=0"
                   Foreground="White"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                    <TextBlock x:Name="DebugSelection"
                   Text="Drag to create a hotspot"
                   Foreground="Cyan"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                </StackPanel>

            </Border>
            <Grid Grid.Row="1"
              x:Name="HUDGrid" Panel.ZIndex="1">
                <Grid.Resources>
                    <!-- Menu buttons fill the pocket's width at their natural 182x62 shape. -->
                    <Style TargetType="Image" x:Key="MenuButtonStyle">
                        <Setter Property="Stretch" Value="Uniform"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>


                <!--
                    HUD layout (this row is 1920x400; numbers are pixels in it).
                    hud_frame.png is built at exactly 1920x400 by
                    Tools/build_hud_frame.py, so nothing is stretched:
                      left button pocket   x 59-236,    y 130-374
                      middle text panel    x 272-1647,  y 138-366
                      right pocket (free)  x 1683-1862, y 130-374
                -->

                <!-- Description text, inside the middle panel with padding. -->
                <TextBlock x:Name="DescriptionText"
           Margin="300,158,300,0"
           Height="190"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Top"
           Text=""
           Foreground="#C8A96A"
           FontFamily="Georgia"
           FontWeight="Bold"
           FontSize="24"
           LineHeight="34"
           TextWrapping="Wrap"
           TextTrimming="CharacterEllipsis"
           Panel.ZIndex="110" />

                <!-- Shown while a reply is waiting to be clicked away (blinks). -->
                <TextBlock x:Name="ContinueHint"
           Text="▼  click to continue"
           Margin="0,326,300,0"
           HorizontalAlignment="Right"
           VerticalAlignment="Top"
           Foreground="#B9A98D"
           FontFamily="Georgia"
           FontStyle="Italic"
           FontSize="16"
           Visibility="Collapsed"
           IsHitTestVisible="False"
           Panel.ZIndex="111" />

                <!--
                    TALK DIALOG (text part): replaces the description text in
                    the middle panel. Speaker name, their line, then up to 4
                    numbered choices (click, or press 1-4).
                -->
                <StackPanel x:Name="DialoguePanel"
                            Margin="300,150,300,0"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Panel.ZIndex="110">

                    <Grid>
                        <TextBlock x:Name="DialogueSpeakerText"
                                   Foreground="#C8A96A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="18"/>

                        <!-- Shown when the player has items to offer -->
                        <TextBlock x:Name="DialogueItemHint"
                                   Text="ITEM: offer something"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#756A59"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="15"/>
                    </Grid>

                    <TextBlock x:Name="DialogueLineText"
                               Foreground="#DDD4C3"
                               FontFamily="Georgia"
                               FontSize="16"
                               LineHeight="30"
                               TextWrapping="Wrap"
                               Margin="0,2,0,10"/>

                    <StackPanel x:Name="DialogueChoicesPanel"/>
                </StackPanel>

                <!--
                    FIGHT PANEL: replaces the description text during a fight.
                    Your two bone dice and total on the left, the enemy's on
                    the right, the result underneath. Click it when the fight
                    is over to continue.
                -->
                <Grid x:Name="FightPanel"
                      Margin="300,146,300,0"
                      Height="214"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      Visibility="Collapsed"
                      MouseLeftButtonDown="FightPanel_MouseLeftButtonDown"
                      Panel.ZIndex="110">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header: enemy name + health bar -->
                    <Grid>
                        <TextBlock x:Name="FightTitleText"
                                   Text="FIGHT!"
                                   Foreground="#C8A96A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
                                   FontSize="20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="EnemyHealthText"
                                       Text="30/30"
                                       Foreground="#D95C52"
                                       FontFamily="Consolas"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Border Width="260" Height="10" VerticalAlignment="Center"
                                    Background="#401010" BorderBrush="#806B4A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="EnemyHealthFill" Width="1*"/>
                                        <ColumnDefinition x:Name="EnemyHealthEmpty" Width="0*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="#C0392B"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Dice -->
                    <Grid Grid.Row="1" Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="PlayerDie1" Width="72" Height="72" Source="/Assets/UI/Dice/die_6.png" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                </Image>
                            <Image x:Name="PlayerDie2" Width="72" Height="72" Source="/Assets/UI/Dice/die_6.png" RenderTransformOrigin="0.5,0.5" Margin="6,0,0,0">
                                    <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                </Image>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="YOU" Foreground="#B9A98D" FontFamily="Georgia" FontSize="15"/>
                                <TextBlock x:Name="PlayerAttackText" Text="-" Foreground="#DDD4C3" FontFamily="Consolas" FontSize="30"/>
                                <TextBlock x:Name="PlayerAttackDetail" Text="" Foreground="#887966" FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="VS"
                                   Foreground="#806B4A"
                                   FontFamily="Georgia"
                                   FontWeight="Bold"
