<Window x:Class="The_Mansion.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="The Mansion"
    SizeToContent="WidthAndHeight"
    ResizeMode="CanMinimize"
    WindowStartupLocation="Manual"
    Background="Black">

    <!--
        Fixed-size window with a normal title bar (minimize + close, no
        resize/maximize). The game area inside it is hardcoded to
        1920x1080; SizeToContent wraps the window around it. All screens,
        canvases and hotspot coordinates are laid out in this 1920x1080 space.
    -->
    <Grid x:Name="RootGrid"
          Width="1920"
          Height="1080"
          ClipToBounds="True">
        <!-- ========================================= -->
        <!-- TITLE SCREEN                              -->
        <!-- ========================================= -->

        <Grid x:Name="TitleScreen" Visibility="Visible" >

            <Image Source="Assets/UI/title_screen.png"
               Stretch="Fill"/>
            <Canvas>
                <Rectangle x:Name="NewGameBtn"
             Canvas.Left="239"
             Canvas.Top="435"
             Width="360"
             Height="74"
             Fill="Transparent"
             Cursor="Hand"
             MouseLeftButtonDown="TitleButton_MouseDown" HorizontalAlignment="Center" VerticalAlignment="Top"/>


            </Canvas>

        </Grid>
        <!-- ======================================== -->
        <!-- BACKSTORY SCREEN                         -->
        <!-- ======================================== -->

        <Grid x:Name="BackstoryScreen"
          Visibility="Collapsed"
          Background="Black">

            <!-- Dark mansion image -->

            <Image Source="/Assets/UI/title_background.png"
               Stretch="Fill"
               Opacity="0.55"/>

            <!-- Dark overlay makes text easy to read -->

            <Rectangle Fill="#99000000"/>


            <!-- Story -->

            <Grid Width="950"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="THE MANSION"
                           HorizontalAlignment="Center"
                           Foreground="#C8A96A"
                           FontFamily="Georgia"
                           FontSize="46"
                           FontWeight="Bold"
                           Margin="0,0,0,45"/>


                    <TextBlock x:Name="BackstoryText"
                           Foreground="#DDD4C3"
                           FontFamily="Georgia"
                           FontSize="24"
                           LineHeight="38"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>


                    <TextBlock Text="Click to continue..."
                           HorizontalAlignment="Center"
                           Foreground="#887966"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="18"
                           Margin="0,55,0,0"/>

                </StackPanel>

            </Grid>


            <!-- Click anywhere -->

            <Rectangle Fill="Transparent"
                   Cursor="Hand"
                   MouseLeftButtonDown="Backstory_MouseLeftButtonDown"/>

        </Grid>
        <Grid x:Name="PlayerRollScreen"
      Visibility="Collapsed"
      Background="#FF070707">

            <!-- Background -->

            <Image Source="Assets/UI/title_background.png"
           Stretch="UniformToFill"
           Opacity="0.25"
           IsHitTestVisible="False"/>

            <Rectangle Fill="#99000000"
               IsHitTestVisible="False"/>


            <!-- Character generation panel -->

            <Border Width="700"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#E6100C0C"
            BorderBrush="#806B4A"
            BorderThickness="2">

                <StackPanel>
                    <TextBlock Text="YOUR UNFORTUNATE HERO"
   HorizontalAlignment="Center"
   Foreground="#D5B77A"
   FontFamily="Georgia"
   FontWeight="Bold"
   FontSize="35"
   Margin="0,0,0,35"/>

                    <TextBlock Text="NAME"
           Foreground="#B9A98D"
           FontFamily="Georgia"
           FontSize="22"
           HorizontalAlignment="Center"/>

                    <TextBox x:Name="PlayerNameTextBox"
         Width="300"
         Height="40"
         Margin="0,8,0,30"
         FontSize="30"
         MaxLength="20"
         TextAlignment="Center"
         HorizontalAlignment="Center"
         Background="Black"
        Foreground="#D5B77A"/>
                    <TextBlock x:Name="RollCommentText1"
   Text=""
   MinHeight="75"
   Margin="0,35,0,25"
   TextWrapping="Wrap"
   TextAlignment="Center"
   Foreground="#A89A84"
   FontFamily="Georgia"
   FontStyle="Italic"
   FontSize="19"/>


                    <!-- HEALTH -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="HEALTH"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollHealthText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#D95C52"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- STRENGTH -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="STRENGTH"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollStrengthText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- LUCK -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="LUCK"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollLuckText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- WITS -->

                    <Grid Margin="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="WITS"
                           Foreground="#B9A98D"
                           FontFamily="Georgia"
                           FontSize="24"/>

                        <TextBlock x:Name="RollWitsText"
                           Grid.Column="1"
                           Text="--"
                           HorizontalAlignment="Right"
                           Foreground="#DDD4C3"
                           FontFamily="Consolas"
                           FontSize="25"/>

                    </Grid>


                    <!-- COMMENT -->

                    <TextBlock x:Name="RollCommentText"
                       Text=""
                       MinHeight="75"
                       Margin="0,35,0,25"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#A89A84"
                       FontFamily="Georgia"
                       FontStyle="Italic"
                       FontSize="19"/>


                    <!-- REROLLS -->

                    <TextBlock x:Name="RerollsText"
                       Text="Rerolls remaining: 3"
                       HorizontalAlignment="Center"
                       Foreground="#756A59"
                       FontFamily="Georgia"
                       FontSize="16"
                       Margin="0,0,0,20"/>


                    <!-- BUTTONS -->

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Button x:Name="RerollButton"
                        Content="REROLL"
                        Width="180"
                        Height="50"
                        Margin="10"
                        Click="RerollButton_Click"/>

                        <Button Content="ACCEPT"
                        Width="180"
                        Height="50"
                        Margin="10"
                        Click="AcceptRollButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>
        <!-- ========================================= -->
        <!-- GAME SCREEN                               -->
        <!-- ========================================= -->

        <Grid x:Name="GameScreen"
          Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="400"/>
            </Grid.RowDefinitions>

            <!-- Scene spans both rows so the 800px-tall background and its hotspots
                 extend underneath the (partly transparent) HUD frame without being clipped. -->
            <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1">
                <!-- GAME SCENE -->
                <Image x:Name="Return" Height="110" VerticalAlignment="Top" Source="/Assets/UI/return_arrow.png" Canvas.Left="10" Canvas.Top="10" Margin="10,0,0,0" Stretch="Fill" Panel.ZIndex="1" Width="220" HorizontalAlignment="Left" />

                <!--
                    Scene backgrounds (1536x1024) are scaled x1.25 to 1920x1280 and
                    cropped to the 1920x800 area above the HUD, centred vertically
                    (Canvas.Top = -240). Hotspots in Data/Scenes.cs are in source-image
                    pixels and are converted with the same numbers - see
                    SceneImageScale / SceneImageCropTop in MainWindow.xaml.cs.
                -->
                <Canvas Height="800" VerticalAlignment="Top" ClipToBounds="True">
                    <Image x:Name="RoomBackground"
                          Source="Assets/Backgrounds/Mansion/frontgate.png"
                          Width="1920"
                          Height="1280"
                          Canvas.Left="0"
                          Canvas.Top="-240"
                          Stretch="Fill" />
                </Canvas>

                <Canvas x:Name="SceneCanvas"
            Background="Transparent"
            MouseMove="SceneCanvas_MouseMove"
            MouseLeftButtonDown="SceneCanvas_MouseLeftButtonDown"
            MouseLeftButtonUp="SceneCanvas_MouseLeftButtonUp"
            Height="800"
            Panel.ZIndex="10" VerticalAlignment="Top"/>

            </Grid>




            <Border x:Name="DebugPanel"
        Grid.Row="0"
        HorizontalAlignment="Left"
        Margin="1393,10,0,0"
        Padding="10"
        Background="#DD000000"
        BorderBrush="Lime"
        BorderThickness="1"
        Panel.ZIndex="1000"
        IsHitTestVisible="False" Height="136" VerticalAlignment="Top" Width="378">

                <StackPanel>

                    <TextBlock Text="HOTSPOT DEBUG MODE"
                   Foreground="Lime"
                   FontFamily="Consolas"
                   FontSize="16"
                   FontWeight="Bold"/>

                    <TextBlock x:Name="DebugCoordinates"
                   Text="Mouse: X=0 Y=0"
                   Foreground="White"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                    <TextBlock x:Name="DebugSelection"
                   Text="Drag to create a hotspot"
                   Foreground="Cyan"
                   FontFamily="Consolas"
                   FontSize="16"
                   Margin="0,5,0,0"/>

                </StackPanel>

            </Border>
            <Grid Grid.Row="1"
              x:Name="HUDGrid" Panel.ZIndex="1">
                <Grid.Resources>
                    <!-- Menu buttons fill the pocket's width at their natural 182x62 shape. -->
                    <Style TargetType="Image" x:Key="MenuButtonStyle">
                        <Setter Property="Stretch" Value="Uniform"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>


                <!--
                    HUD layout (this row is 1920x400; numbers are pixels in it).
                    hud_frame.png is built at exactly 1920x400 by
                    Tools/build_hud_frame.py, so nothing is stretched:
                      left button pocket   x 59-236,    y 130-374
                      middle text panel    x 272-1647,  y 138-366
                      right pocket (free)  x 1683-1862, y 130-374
                -->

                <!-- Description text, inside the middle panel with padding. -->
                <TextBlock x:Name="DescriptionText"
           Margin="300,158,300,0"
           Height="190"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Top"
           Text=""
           Foreground="#DDD4C3"
           FontFamily="Georgia"
           FontSize="24"
           LineHeight="34"
           TextWrapping="Wrap"
           TextTrimming="CharacterEllipsis"
           Panel.ZIndex="110" />

                <Image x:Name="HUDDiveders"
  Source="/Assets/UI/hud_frame.png"
  Width="1920"
  Height="400"
  IsHitTestVisible="False" Panel.ZIndex="20" Stretch="Fill"/>

                <!-- Menu buttons, inside the left pocket with 4px padding. -->
                <Grid x:Name="MenuButtons" Margin="63,134,0,0" HorizontalAlignment="Left" Width="169" Height="236" VerticalAlignment="Top" Panel.ZIndex="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <!-- LOOK -->

                    <Image x:Name="LookBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="1"
           Grid.Column="0"
           Source="/Assets/UI/Look.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- ACT -->

                    <Image x:Name="ActBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="0"
           Grid.Column="0"
           Source="/Assets/UI/act.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- TALK -->

                    <Image x:Name="TalkBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="2"
           Grid.Column="0"
           Source="/Assets/UI/talk.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>


                    <!-- ITEM -->

                    <Image x:Name="ItemBtn" Style="{StaticResource MenuButtonStyle}"
           Grid.Row="3"
           Grid.Column="0"
           Source="/Assets/UI/item.png"
           MouseEnter="MenuButton_MouseEnter"
           MouseLeftButtonDown="MenuButton_MouseDown"
           MouseLeave="MenuButton_MouseLeave"/>

                </Grid>


            </Grid>

        </Grid>

    </Grid>
</Window>
